datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                         String         @id @default(uuid())
  email                      String         @unique
  name                       String
  handle                     String         @unique
  avatarUrl                  String?
  streakDays                 Int            @default(1)
  reclaimedToday             Int            @default(0) // In seconds - starts from scratch for new user
  loopsBrokenToday           Int            @default(0)
  reelsAvoidedToday          Int            @default(0)
  completedPausesToday       Int            @default(0)
  spiritualMantra            String?        @default("Resting my weary spirit in quietude. Choosing deep presence over digital chaos.")
  spiritualSeason            String?        @default("Season of Sacred Healing")
  soulPresenceState          String?        @default("Healing & Resting")
  soulAura                   String?        @default("Emerald")
  sacredBellSound            String?        @default("Tibetan Singing Bowl")
  dailyStillnessGoalMinutes  Int            @default(20)
  bonsaiVitality             Int            @default(50)
  bonsaiStage                String         @default("seedling")
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  sentPauses       PauseMessage[] @relation("SentPauses")
  receivedPauses   PauseMessage[] @relation("ReceivedPauses")
  presencePacts    PresencePact[]
  friendshipsInitiated Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  receiverId  String
  status      String   @default("pending") // "pending", "accepted", "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model PauseMessage {
  id               String   @id @default(uuid())
  senderId         String
  receiverId       String
  title            String   // e.g. "Gift of Presence", "10-Second Breath Check"
  note             String   // Mindful intention note
  durationSeconds  Int      // 5, 10, 15, 20, 30
  tag              String   // "Featured", "Presence Pact", "Intervention"
  isRead           Boolean  @default(false)
  isCompleted      Boolean  @default(false)
  steppedAwayEarly Boolean  @default(false)
  createdAt        DateTime @default(now())

  sender           User     @relation("SentPauses", fields: [senderId], references: [id], onDelete: Cascade)
  receiver         User     @relation("ReceivedPauses", fields: [receiverId], references: [id], onDelete: Cascade)
}

model PresencePact {
  id               String   @id @default(uuid())
  userId           String
  partnerName      String
  durationDays     Int      @default(7)
  status           String   @default("active") // "active", "completed", "resting"
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
